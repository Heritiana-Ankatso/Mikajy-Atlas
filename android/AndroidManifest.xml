<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.mikajy.app.free"
    android:versionCode="17"
    android:versionName="6.1">

    <!-- Mikajy Free: its own application id (com.mikajy.app.free), so it installs next to Mikajy and never replaces it. The Java classes keep
         the package com.mikajy.app, hence the fully qualified names below. Everything runs on the device. INTERNET is used only by UpdateChecker (one GET to GitHub's
         releases API, optional, switchable off in Settings); the WebView itself has network loads blocked. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="true" />

    <application
        android:label="Mikajy Free"
        android:icon="@drawable/icon"
        android:theme="@android:style/Theme.Material.NoActionBar"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">

        <!-- Every configuration change is handled in-place so that a system
             dark-mode switch, fold/unfold or font-scale change never destroys the canvas. -->
        <activity
            android:name="com.mikajy.app.MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|uiMode|keyboard|keyboardHidden|layoutDirection|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="com.mikajy.app.ShareProvider"
            android:authorities="com.mikajy.app.free.share"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
